generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DISASTER_OFFICER
  RESOURCE_MANAGER
  RELIEF_CAMP_MANAGER
  VOLUNTEER
}

enum DisasterType {
  Flood
  Earthquake
  Cyclone
  Landslide
  Wildfire
  Drought
  Industrial_Accident
  Other
}

enum SeverityLevel {
  Low
  Medium
  High
  Critical
}

enum DisasterStatus {
  Active
  Monitoring
  Resolved
}

enum ResourceCategory {
  Food
  Water
  Medicine
  Clothing
  Blankets
  Tents
  Rescue_Equipment
  Fuel
  Hygiene_Kits
  Medical_Equipment
  Other
}

enum ResourceStatus {
  Available
  Low_Stock
  Out_of_Stock
  Expired
}

enum CenterType {
  Relief_Camp
  Hospital
  Shelter
  Mobile_Unit
}

enum EmergencyLevel {
  Normal
  High
  Critical
}

enum RequestPriority {
  Critical
  High
  Medium
  Low
}

enum RequestStatus {
  Pending
  Under_Review
  Approved
  Partially_Fulfilled
  Fulfilled
  Rejected
  Cancelled
}

enum AllocationStatus {
  Allocated
  Dispatched
  Delivered
  Cancelled
}

enum DeliveryStatus {
  Pending
  Dispatched
  In_Transit
  Delivered
  Delayed
  Cancelled
}

enum VolunteerAvailability {
  Available
  Deployed
  On_Leave
}

enum TaskPriority {
  Critical
  High
  Medium
  Low
}

enum TaskStatus {
  Pending
  In_Progress
  Completed
  Cancelled
}

enum NotificationType {
  CRITICAL_REQUEST
  REQUEST_STATUS
  LOW_INVENTORY
  DELIVERY_UPDATE
  TASK_ASSIGNED
  DISASTER_ALERT
  SYSTEM
}

model User {
  id               String            @id @default(uuid())
  name             String
  email            String            @unique
  password         String
  role             Role              @default(VOLUNTEER)
  phone            String?
  avatar           String?
  reliefCenterId   String?
  warehouseId      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  reliefCenter     ReliefCenter?     @relation(fields: [reliefCenterId], references: [id], onDelete: SetNull)
  warehouse        Warehouse?        @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  
  disastersCreated Disaster[]        @relation("DisasterCreatedBy")
  requestsCreated  ResourceRequest[] @relation("RequestRequester")
  allocationsMade  ResourceAllocation[] @relation("AllocatedByUser")
  deliveriesDriven Delivery[]        @relation("DeliveryDriver")
  volunteers       Volunteer[]
  notifications    Notification[]
  auditLogs        AuditLog[]
}

model Disaster {
  id                  String         @id @default(uuid())
  name                String
  type                DisasterType
  description         String
  severity            SeverityLevel
  status              DisasterStatus @default(Active)
  affectedArea        String
  latitude            Float
  longitude           Float
  estimatedPopulation Int            @default(0)
  startDate           DateTime
  endDate             DateTime?
  createdById         String
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  createdBy           User           @relation("DisasterCreatedBy", fields: [createdById], references: [id])
  requests            ResourceRequest[]
  volunteers          Volunteer[]
  tasks               Task[]
}

model Warehouse {
  id                 String     @id @default(uuid())
  name               String
  address            String
  city               String
  state              String
  latitude           Float
  longitude          Float
  capacity           Float      @default(1000) // e.g. in tonnes or units
  contactPerson      String
  phone              String
  currentUtilization Float      @default(0) // percentage or total volume
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  resources          Resource[]
  deliveriesFrom     Delivery[] @relation("SourceWarehouse")
  users              User[]
}

model Resource {
  id             String           @id @default(uuid())
  name           String
  category       ResourceCategory
  unit           String           // e.g. kg, liters, boxes, kits, units
  quantity       Int              @default(0)
  minStockLevel  Int              @default(10)
  expiryDate     DateTime?
  warehouseId    String
  status         ResourceStatus   @default(Available)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  warehouse      Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  requestItems   RequestItem[]
  allocations    ResourceAllocation[]
  deliveryItems  DeliveryItem[]

  @@index([warehouseId])
  @@index([category])
}

model ReliefCenter {
  id                String          @id @default(uuid())
  name              String
  type              CenterType
  address           String
  city              String
  state             String
  latitude          Float
  longitude         Float
  capacity          Int             @default(500)
  currentPopulation Int             @default(0)
  contactPerson     String
  phone             String
  emergencyLevel    EmergencyLevel  @default(Normal)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  requests          ResourceRequest[]
  deliveriesTo      Delivery[]      @relation("DestinationCenter")
  users             User[]
}

model ResourceRequest {
  id                  String             @id @default(uuid())
  requesterId         String
  disasterId          String
  destinationCenterId String
  priority            RequestPriority    @default(Medium)
  justification       String
  status              RequestStatus      @default(Pending)
  requestedDate       DateTime           @default(now())
  approvedDate        DateTime?
  fulfilledDate       DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  requester           User               @relation("RequestRequester", fields: [requesterId], references: [id])
  disaster            Disaster           @relation(fields: [disasterId], references: [id], onDelete: Cascade)
  destinationCenter   ReliefCenter       @relation(fields: [destinationCenterId], references: [id], onDelete: Cascade)
  
  items               RequestItem[]
  allocations         ResourceAllocation[]
  deliveries          Delivery[]
}

model RequestItem {
  id                String           @id @default(uuid())
  requestId         String
  resourceId        String?
  category          ResourceCategory
  requestedQuantity Int
  fulfilledQuantity Int              @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  request           ResourceRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  resource          Resource?        @relation(fields: [resourceId], references: [id], onDelete: SetNull)
}

model ResourceAllocation {
  id                String           @id @default(uuid())
  requestId         String
  resourceId        String
  allocatedQuantity Int
  allocatedById     String
  allocatedAt       DateTime         @default(now())
  status            AllocationStatus @default(Allocated)
  notes             String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  request           ResourceRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  resource          Resource         @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  allocatedBy       User             @relation("AllocatedByUser", fields: [allocatedById], references: [id])
  deliveryItems     DeliveryItem[]
}

model Delivery {
  id                  String         @id @default(uuid())
  requestId           String
  sourceWarehouseId   String
  destinationCenterId String
  assignedVehicle     String
  driverName          String
  driverPhone         String
  driverUserId        String?
  status              DeliveryStatus @default(Pending)
  departureTime       DateTime?
  estimatedArrival    DateTime?
  actualArrival       DateTime?
  trackingNotes       String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  request             ResourceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  sourceWarehouse     Warehouse       @relation("SourceWarehouse", fields: [sourceWarehouseId], references: [id])
  destinationCenter   ReliefCenter    @relation("DestinationCenter", fields: [destinationCenterId], references: [id])
  driverUser          User?           @relation("DeliveryDriver", fields: [driverUserId], references: [id], onDelete: SetNull)
  
  items               DeliveryItem[]
}

model DeliveryItem {
  id           String             @id @default(uuid())
  deliveryId   String
  resourceId   String
  allocationId String?
  quantity     Int
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  delivery     Delivery           @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  resource     Resource           @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  allocation   ResourceAllocation? @relation(fields: [allocationId], references: [id], onDelete: SetNull)
}

model Volunteer {
  id                String                @id @default(uuid())
  userId            String?
  name              String
  email             String
  phone             String
  skills            String                // comma-separated list of skills
  availability      VolunteerAvailability @default(Available)
  location          String
  status            String                @default("Active")
  assignedDisasterId String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  user              User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  assignedDisaster  Disaster?             @relation(fields: [assignedDisasterId], references: [id], onDelete: SetNull)
  tasks             Task[]
}

model Task {
  id                  String       @id @default(uuid())
  title               String
  description         String
  disasterId          String
  assignedVolunteerId String?
  priority            TaskPriority @default(Medium)
  status              TaskStatus   @default(Pending)
  dueDate             DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  disaster            Disaster     @relation(fields: [disasterId], references: [id], onDelete: Cascade)
  assignedVolunteer   Volunteer?   @relation(fields: [assignedVolunteerId], references: [id], onDelete: SetNull)
}

model Notification {
  id        String           @id @default(uuid())
  userId    String?          // null means broadcast to all users
  title     String
  message   String
  type      NotificationType @default(SYSTEM)
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  user      User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id            String   @id @default(uuid())
  action        String
  entity        String
  entityId      String?
  performedById String?
  details       String?
  ipAddress     String?
  createdAt     DateTime @default(now())

  performedBy   User?    @relation(fields: [performedById], references: [id], onDelete: SetNull)
}
